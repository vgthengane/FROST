{
  "_paper": "FROST paper recipe — Adapter + CorrMem + ProtoMem + Fusion (EF only)",
  "lgsp_fscil": true,
  "model_name": "frost_bufferfree",
  "fscil_preset": "exemplar_buffer_free",
  "seed": [1947, 1991, 2001, 2008, 2019],

  "backbone_type": "pretrained_vit_b16_224_in21k_adapter",
  "data_path": "_datasets/images",
  "sessions_root": "datasets/session_images",
  "device": ["0"],
  "batch_size": 48,
  "num_workers": 8,

  "adapter": {
    "ffn_num": 64,
    "base_only": true,
    "task0_warmup": true,
    "increment_warmup": false,
    "epochs": 10,
    "lr": 0.01,
    "init_lr": 0.01,
    "weight_decay": 0.0005,
    "min_lr": 0.0,
    "optimizer": "sgd"
  },
  "corrmem": {
    "lift_v": 2000
  },
  "protomem": {
    "insert": "mean"
  },
  "fusion": {
    "mode": "corr_proto",
    "alpha": 0.5
  }
}
